# ── Dominio ──
DOMAIN=localhost

# ── Postgres ──
POSTGRES_PASSWORD=cambia-esta-password-segura

# ── JWT (genera con: openssl rand -hex 32) ──
JWT_SECRET=cambia-este-jwt-secret-muy-largo

# ── Claves Supabase (genera con el script scripts/generate-keys.js) ──
ANON_KEY=tu-anon-key-aqui
SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── SMTP (opcional, para emails) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@tudominio.com
